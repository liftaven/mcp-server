{
  "name": "liftaven-mcp",
  "version": "1.1.1",
  "description": "MCP connector for Liftaven SEO research, connected search reports and reviewed website proposals.",
  "type": "module",
  "bin": {
    "liftaven-mcp": "server/index.js"
  },
  "files": [
    "server",
    "icon.png",
    "manifest.json",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.mjs",
    "bundle": "mcpb pack . liftaven.mcpb"
  },
  "dependencies": {
    "mcp-remote": "0.14.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Codex",
  "contributors": [
    {
      "name": "Codex"
    }
  ],
  "license": "MIT",
  "homepage": "https://liftaven.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liftaven/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/liftaven/mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "liftaven",
    "seo",
    "search-console",
    "google-analytics",
    "website-optimization"
  ],
  "mcpName": "io.github.liftaven/mcp-server",
  "overrides": {
    "tmp": "^0.2.6"
  }
}
